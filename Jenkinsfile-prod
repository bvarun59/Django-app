pipeline {
    agent any
    environment {
        IMAGE_NAME = "varundocker3/django:v1"
    }
    stages {
        stage("git clone") {
            steps {
                echo "checkout scm"
            // sh 'git clone https://github.com/bvarun59/Docker.git'
            }
            
        }
        stage("build docker image") {
            steps {
                echo "build image"
                withCredentials([usernamePassword(credentialsId: 'Dockerhub-Cred', passwordVariable: 'DHUB_PASS', usernameVariable: 'DHUB_USER')]) {
                sh 'docker build -t $IMAGE_NAME .'
                }
            }
        }
        stage("push docker image") {
            steps{
                echo "push image to dockerhub"
                withCredentials([usernamePassword(credentialsId: 'Dockerhub-Cred', passwordVariable: 'DHUB_PASS', usernameVariable: 'DHUB_USER')]) {
                 sh 'docker push $IMAGE_NAME'
                    }
                
            }
        }
        stage("deploy comtainer") {
            steps{
                echo "deployed comtainers"
            }
        }
        
    }
}